# Copy this file to .env and fill in real values. .env is gitignored.

# Google Routes API key (Routes API must be enabled on the associated GCP project).
# https://developers.google.com/maps/documentation/routes/get-api-key
GOOGLE_MAPS_API_KEY=replace_me

# Production only -- leave unset for local dev, which defaults to
# backend/transit_lab.db. See docs/architecture.md for the bootstrap flow.
# DATABASE_PATH=/var/data/transit_lab.db
# GTFS_CTA_ZIP_PATH=/var/data/gtfs/cta.zip
# GTFS_DART_ZIP_PATH=/var/data/gtfs/dart.zip
